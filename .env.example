# ==============================================================================
# Multi-Tenant Hotel & Lodge Platform Environment Variables
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or expose the service role key to the browser!
# ==============================================================================

# Unique tenant identifier matching 'sites.id' in Supabase database
SITE_ID=demo-hotel-jaipur

# Canonical base URL for SEO, sitemaps, and OpenGraph images
NEXT_PUBLIC_SITE_URL=https://shantinivasheritage.com

# Supabase Managed Backend Public Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (ONLY for database migrations / seeds / tests; NEVER NEXT_PUBLIC!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
